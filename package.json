{
	"name": "canvas-mcp-worker",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"status": "node scripts/setup.mjs status",
		"deploy": "node scripts/setup.mjs deploy",
		"secret": "node scripts/set-secret.mjs",
		"e2e": "node scripts/e2e.mjs",
		"dev": "wrangler dev",
